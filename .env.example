# ============================================================================
# Environment Variables for Local Development
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env only if you really need local overrides
# 2. Keep .env local and never commit it
# 3. Add future shared settings here when database and integrations arrive
#
# ============================================================================

# Server Configuration
# Used by backend.main when launched directly; defaults to 8080.
PORT=8080

# Google login protection.
# Keep false until the login flow is tested end-to-end.
AUTH_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=163366057562-044umbigkalek9h110lb6ho5f8k5vnqe.apps.googleusercontent.com
AUTH_ALLOWED_EMAILS=amministrazione@pnl-evolution.com
AUTH_SESSION_SECRET=change-me-with-a-long-random-string
AUTH_COOKIE_SECURE=true
